# Copy to .env and fill values
# DOMAIN for TLS and nginx
DOMAIN=your-domain.example

# Signaling port exposed on host
SIGNALING_PORT=3000

# TURN server settings (coturn)
# If using long-term auth secret, client will calculate time-limited credentials.
TURN_URL=turn:your-vm-ip
TURN_USER=turnuser
TURN_PASS=turnpass

# For Oracle Autonomous DB (if you plan to use it)
# Put wallet files under server/oracle_wallet and set ORACLE_WALLET_DIR accordingly
ORACLE_WALLET_DIR=/opt/oracle/wallet
ORACLE_USER=admin
ORACLE_CONNECT_STRING=YOUR_TNS_ALIAS
